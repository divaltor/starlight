{
  "name": "starlight",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@prisma/client": "7.10.1",
      "prisma-json-types-generator": "5.2.0",
      "@prisma/adapter-pg": "7.10.1",
      "@prisma/instrumentation": "^7.10.1",
      "tsdown": "0.23.2",
      "@orpc/server": "1.16.1",
      "@orpc/client": "1.16.1",
      "zod": "4.6.7",
      "prisma": "7.10.1",
      "grammy": "1.46.0",
      "ky": "2.2.0"
    }
  },
  "scripts": {
    "lint": "oxlint --fix && ast-grep scan -c script/ast-grep/sgconfig.yml apps/server/src apps/starlight/src packages/api/src && turbo lint",
    "typecheck": "turbo typecheck",
    "test:ast-grep-rules": "ast-grep test -c script/ast-grep/sgconfig.yml",
    "format": "turbo format",
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "dev:starlight": "turbo -F @starlight/bot dev",
    "start:server": "turbo -F server start",
    "start:starlight": "turbo -F @starlight/bot start",
    "start:web": "turbo -F web start",
    "db:deploy": "turbo -F @starlight/utils db:deploy",
    "db:generate": "turbo -F @starlight/utils db:generate",
    "db:migrate": "turbo -F @starlight/utils db:migrate",
    "queue:classify": "turbo -F server queue:classify",
    "queue:embeddings": "turbo -F server queue:embeddings"
  },
  "dependencies": {},
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@types/bun": "1.4.4",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-plugin-react-doctor": "0.9.18",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.2",
    "turbo": "2.11.10",
    "typescript": "7.1.0-beta",
    "ultracite": "8.0.2"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "@effect/platform-node-shared": "4.0.5",
    "@opentelemetry/core": "2.12.0",
    "fast-uri": "4.2.2",
    "find-my-way": "9.10.0",
    "lodash": "4.18.1",
    "valibot": "1.5.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "patchedDependencies": {
    "@netzlabor/pi-durable-postgres@0.2.0": "patches/@netzlabor%2Fpi-durable-postgres@0.2.0.patch"
  }
}
