{
  "name": "starlight",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@prisma/client": "^7.9.1",
      "prisma-json-types-generator": "^5.1.1",
      "@prisma/adapter-pg": "^7.9.1",
      "@prisma/instrumentation": "^7.9.1",
      "tsdown": "^0.22.14",
      "@orpc/server": "^1.15.0",
      "@orpc/client": "^1.15.0",
      "zod": "^4.4.3",
      "prisma": "^7.9.1",
      "grammy": "^1.45.1",
      "ky": "^2.0.2"
    }
  },
  "scripts": {
    "lint": "turbo lint",
    "format": "turbo format",
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "prestart:server": "bun run db:generate && bun run db:deploy",
    "start:server": "turbo -F server start",
    "start:web": "turbo -F web start",
    "db:deploy": "turbo -F @starlight/utils db:deploy",
    "db:generate": "turbo -F @starlight/utils db:generate",
    "db:migrate": "turbo -F @starlight/utils db:migrate",
    "queue:classify": "turbo -F server queue:classify",
    "queue:embeddings": "turbo -F server queue:embeddings"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "1.4.0",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "oxlint-plugin-react-doctor": "^0.9.12",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "ultracite": "7.10.6"
  },
  "packageManager": "bun@1.4.0",
  "overrides": {
    "@opentelemetry/core": "2.10.0",
    "fast-uri": "3.1.5",
    "find-my-way": "9.7.0",
    "lodash": "4.18.0",
    "valibot": "1.4.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
