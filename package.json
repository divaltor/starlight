{
  "name": "starlight",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@prisma/client": "7.10.0",
      "prisma-json-types-generator": "5.2.0",
      "@prisma/adapter-pg": "7.10.0",
      "@prisma/instrumentation": "^7.10.0",
      "tsdown": "0.23.1",
      "@orpc/server": "1.15.6",
      "@orpc/client": "1.15.6",
      "zod": "4.6.7",
      "prisma": "7.10.0",
      "grammy": "1.46.0",
      "ky": "2.2.0"
    }
  },
  "scripts": {
    "lint": "oxlint --fix && ast-grep scan -c script/ast-grep/sgconfig.yml apps/server/src apps/starlight/src packages/api/src && turbo lint",
    "typecheck": "turbo typecheck",
    "test:ast-grep-rules": "ast-grep test -c script/ast-grep/sgconfig.yml",
    "format": "turbo format",
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "dev:starlight": "turbo -F @starlight/bot dev",
    "start:server": "turbo -F server start",
    "start:starlight": "turbo -F @starlight/bot start",
    "start:web": "turbo -F web start",
    "db:deploy": "turbo -F @starlight/utils db:deploy",
    "db:generate": "turbo -F @starlight/utils db:generate",
    "db:migrate": "turbo -F @starlight/utils db:migrate",
    "queue:classify": "turbo -F server queue:classify",
    "queue:embeddings": "turbo -F server queue:embeddings"
  },
  "dependencies": {},
  "devDependencies": {
    "@ast-grep/cli": "0.50.0",
    "@types/bun": "1.4.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-plugin-react-doctor": "0.9.18",
    "oxlint-tsgolint": "7.0.2004",
    "tsdown": "0.23.1",
    "turbo": "2.11.8",
    "typescript": "7.0.2",
    "ultracite": "8.0.1"
  },
  "packageManager": "bun@1.4.3",
  "overrides": {
    "@effect/platform-node-shared": "4.0.4",
    "@opentelemetry/core": "2.12.0",
    "fast-uri": "4.2.2",
    "find-my-way": "9.10.0",
    "lodash": "4.18.1",
    "valibot": "1.5.0"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
