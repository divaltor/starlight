{
  "name": "@starlight/crypto",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.mts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "bun run -b tsdown",
    "lint": "tsc -b",
    "typecheck": "tsc -b",
    "format": "oxfmt"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0",
    "@noble/hashes": "^2.3.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
