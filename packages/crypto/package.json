{
  "name": "@starlight/crypto",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.mts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "bun run -b tsdown",
    "lint": "bun check -b",
    "typecheck": "bun check -b",
    "format": "bun fmt"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "peerDependencies": {
    "typescript": "7.1.0-beta"
  }
}
