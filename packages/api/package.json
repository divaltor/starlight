{
  "name": "@starlight/api",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run -b tsdown",
    "lint": "tsc -b",
    "format": "oxfmt"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "@types/bun": "1.4.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@book000/pixivts": "^0.63.0",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@starlight/crypto": "workspace:*",
    "@starlight/utils": "workspace:*",
    "@telegram-apps/init-data-node": "^2.0.10",
    "date-fns": "^4.4.0",
    "effect": "4.0.0-rc.111",
    "zod": "catalog:"
  }
}
