datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
  runtime         = "bun"
}

generator json {
  provider = "prisma-json-types-generator"
}

enum ChatMemoryScope {
  topic
  global
}

model User {
  id                  String  @id @default(uuid(7)) @db.Uuid
  telegramId          BigInt  @unique @map("telegram_id")
  username            String? @unique
  firstName           String  @map("first_name")
  lastName            String? @map("last_name")
  isBot               Boolean @default(false) @map("is_bot")
  isPublic            Boolean @default(false) @map("is_public")
  pixivIncludePrivate Boolean @default(false) @map("pixiv_include_private")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  posts               Post[]
  media               Media[]
  videos              Video[]
  chatMembers         ChatMember[]
  providerCredentials ProviderCredential[]

  @@map("users")
}

model ProviderCredential {
  userId          String   @map("user_id") @db.Uuid
  provider        String
  credentialType  String   @map("credential_type")
  encryptedSecret String   @map("encrypted_secret") @db.Text
  externalUserId  String?  @map("external_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, provider])
  @@map("provider_credentials")
}

model Chat {
  // Telegram ID
  id       BigInt  @id
  title    String?
  username String?

  settings Json @default("{}")

  photoThumbnail String? @map("photo_thumbnail")
  photoBig       String? @map("photo_big")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  messages      Message[]
  chatMembers   ChatMember[]
  memoryCursors ChatMemoryCursor[]
  memoryNotes   ChatMemoryNote[]

  @@map("chats")
}

model ChatMemoryCursor {
  chatId BigInt          @map("chat_id")
  scope  ChatMemoryScope

  threadKey Int @default(0) @map("thread_key")

  lastMessageId Int @default(0) @map("last_message_id")

  failureCount Int @default(0) @map("failure_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, scope, threadKey])
  @@index([chatId, scope, updatedAt(sort: Desc)])
  @@map("chat_memory_cursors")
}

model ChatMemoryNote {
  id     String          @id @default(uuid(7)) @db.Uuid
  chatId BigInt          @map("chat_id")
  scope  ChatMemoryScope

  threadKey Int @default(0) @map("thread_key")

  startMessageId Int @map("start_message_id")
  endMessageId   Int @map("end_message_id")
  messageCount   Int @map("message_count")

  summary String @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, scope, threadKey, endMessageId])
  @@index([chatId, scope, threadKey, createdAt(sort: Desc)])
  @@index([chatId, scope, createdAt(sort: Desc)])
  @@map("chat_memory_notes")
}

model ChatMember {
  chatId BigInt @map("chat_id")
  userId String @map("user_id") @db.Uuid

  status     String
  supervisor Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([chatId, supervisor])
  @@index([userId])
  @@index([status])
  @@map("chat_members")
}

model Post {
  id               String   @map("external_id")
  userId           String   @map("user_id") @db.Uuid
  provider         String
  sourceUrl        String   @map("source_url")
  authorExternalId String?  @map("author_external_id")
  authorName       String?  @map("author_name")
  authorUsername   String?  @map("author_username")
  title            String?
  text             String?  @db.Text
  tags             String[] @default([])

  providerPayload Json @map("provider_payload")

  // Kept for compatibility with existing gallery reads.
  username String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  media Media[]
  user  User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id(name: "postId", [id, userId, provider])
  @@index([userId, createdAt(sort: Desc)])
  @@index([username])
  @@map("posts")
}

model Media {
  id             String  @map("external_id")
  postId         String  @map("post_external_id")
  userId         String  @map("user_id") @db.Uuid
  provider       String
  kind           String  @default("image")
  position       Int     @default(0)
  s3Path         String? @map("s3_path")
  originalUrl    String  @map("original_url")
  perceptualHash String? @map("perceptual_hash")

  /// [ClassificationType]
  classification Json? @map("classification")

  imageVec Unsupported("vector(1024)")? @map("image_vec")
  tagVec   Unsupported("vector(1024)")? @map("tag_vec")

  height Int? @map("height")
  width  Int? @map("width")

  // Generated hash bucket columns for similarity search
  hashBucket4  String? @default(dbgenerated()) @map("hash_bucket_4")
  hashBucket8  String? @default(dbgenerated()) @map("hash_bucket_8")
  hashBucket12 String? @default(dbgenerated()) @map("hash_bucket_12")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  post Post @relation(fields: [postId, userId, provider], references: [id, userId, provider], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id(name: "mediaId", [id, userId, provider])
  @@unique([postId, userId, provider, position])
  @@index([postId])
  @@index([perceptualHash])
  @@index([hashBucket4])
  @@index([hashBucket8])
  @@index([hashBucket12])
  @@index([s3Path])
  @@index([deletedAt])
  @@index([createdAt(sort: Desc)])
  @@map("media")
}

model Video {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  tweetId   String  @map("tweet_id")
  tweetText String? @map("tweet_text") @db.Text

  telegramFileId       String @map("telegram_file_id")
  telegramFileUniqueId String @map("telegram_file_unique_id")

  width  Int?
  height Int?

  description String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([telegramFileUniqueId, userId])
  @@index([userId])
  @@index([tweetId])
  @@map("videos")
}

model Message {
  messageId Int    @map("message_id")
  chatId    BigInt @map("chat_id")

  // Sender info
  fromId        BigInt? @map("from_id")
  fromUsername  String? @map("from_username")
  fromFirstName String? @map("from_first_name")

  // Message content
  text    String? @db.Text
  caption String? @db.Text

  // Entities for LLM context
  /// [MessageEntitiesType]
  entities        Json? @map("entities")
  /// [MessageEntitiesType]
  captionEntities Json? @map("caption_entities")

  // Media type: photo, video, document, audio, voice, video_note, sticker, animation, poll, etc.
  mediaType String? @map("media_type")

  // Threading / Reply context
  replyToMessageId Int? @map("reply_to_message_id")
  messageThreadId  Int? @map("message_thread_id")

  // Forward origin as JSON
  /// [ForwardOriginType]
  forwardOrigin Json? @map("forward_origin")

  // Full raw message for complete data preservation (LLM processing)
  /// [TelegramMessageType]
  rawData Json @map("raw_data")

  // Telegram timestamps
  date     DateTime  @map("date")
  editDate DateTime? @map("edit_date")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  chat        Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  parts       MessagePart[]

  @@id([messageId, chatId])
  @@index([chatId, date(sort: Desc)])
  @@index([fromId])
  @@index([mediaType])
  @@index([deletedAt])
  @@index([chatId, messageThreadId, messageId])
  @@index([chatId, messageId])
  @@map("messages")
}

model MessagePart {
  id String @id @default(uuid(7)) @db.Uuid

  messageId Int    @map("message_id")
  chatId    BigInt @map("chat_id")

  type String

  /// [MessagePartDataType]
  data Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  message Message @relation(fields: [messageId, chatId], references: [messageId, chatId], onDelete: Cascade)

  @@index([messageId, chatId])
  @@index([chatId, type, createdAt(sort: Desc)])
  @@map("message_parts")
}

model Attachment {
  id Int @id @default(autoincrement())

  messageId Int    @map("message_id")
  chatId    BigInt @map("chat_id")

  attachmentType String  @map("attachment_type")
  mimeType       String  @map("mime_type")
  s3Path         String  @map("s3_path")
  summary        String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  message Message @relation(fields: [messageId, chatId], references: [messageId, chatId], onDelete: Cascade)

  @@index([chatId, messageId])
  @@index([attachmentType])
  @@index([mimeType])
  @@index([s3Path])
  @@map("attachments")
}

model EmbeddingCache {
  query     BigInt                      @id @map("query")
  embedding Unsupported("vector(1024)") @map("embedding")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("embedding_cache")
}
