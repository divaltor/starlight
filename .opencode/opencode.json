{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "langfuse": {
      "type": "remote",
      "url": "{env:LANGFUSE_BASE_URL}/api/public/mcp",
      "headers": {
        "Authorization": "Basic {file:mcp-langfuse-token}"
      },
      "oauth": false,
      "enabled": true,
      "timeout": 30000
    }
  }
}
