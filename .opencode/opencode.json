{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "langfuse": {
      "type": "remote",
      "url": "{env:LANGFUSE_BASE_URL}/api/public/mcp",
      "headers": {
        "Authorization": "Basic {env:LANGFUSE_MCP_TOKEN}"
      },
      "enabled": true,
      "timeout": 30000
    }
  }
}
