# openssl rand -hex 32
API_TOKEN=

DEBUG=true
ENABLE_CLASSIFICATION=true
ENABLE_EMBEDDINGS=true

# Memory-retrieval models for Hindsight (OpenAI-shaped /v1/openai/embeddings,
# Cohere-shaped /v1/rerank). Revisions are pinned commits.
ENABLE_TEXT_EMBEDDINGS=true
TEXT_EMBEDDING_MODEL=sergeyzh/BERTA
TEXT_EMBEDDING_MODEL_REVISION=914c8c8aed14042ed890fc2c662d5e9e66b2faa7
# Alternatives to bake off:
#   BAAI/bge-m3                       5617a9f61b028005a4858fdac845db406aefb181
#   intfloat/multilingual-e5-large    (pin before use)

# WARNING: jina-reranker-v2 is CC-BY-NC-4.0 (non-commercial).
# Apache-2.0 fallback: cross-encoder/mmarco-MiniLMv2-L12-H384-v1
#                      1427fd652930e4ba29e8149678df786c240d8825
ENABLE_RERANKER=true
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANKER_MODEL_REVISION=9cfeff2df7d40d1b78e75e5e9cebec92a99813c9

MODEL_DEVICE=auto

LOG_LEVEL=INFO

# Set to true to disable serving OpenAPI schema and docs endpoints
DISABLE_OPENAPI=false
