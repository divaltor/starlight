# openssl rand -hex 32
API_TOKEN=

DEBUG=true
ENABLE_CLASSIFICATION=true
ENABLE_EMBEDDINGS=true

# Memory-retrieval models for Hindsight (OpenAI-shaped /v1/openai/embeddings,
# Cohere-shaped /v1/rerank). Revisions are pinned commits.
ENABLE_TEXT_EMBEDDINGS=true
TEXT_EMBEDDING_MODEL=BAAI/bge-m3
TEXT_EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# Alternatives to bake off:
#   sergeyzh/BERTA                    914c8c8aed14042ed890fc2c662d5e9e66b2faa7
#   intfloat/multilingual-e5-large    (pin before use)
# BERTA requires distinct search_query/search_document prompts, which Hindsight's
# OpenAI provider cannot convey. Do not use it through this endpoint unchanged.

ENABLE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e

MODEL_DEVICE=auto

LOG_LEVEL=INFO

# Set to true to disable serving OpenAPI schema and docs endpoints
DISABLE_OPENAPI=false
