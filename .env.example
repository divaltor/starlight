# Compose interpolation environment: copied to .env and passed via
# `docker compose --env-file .env`. Per-service templates live next to each
# service: apps/*/.env.example and classification/.env.example.

POSTGRES_PASSWORD=replace-with-url-safe-secret
POSTGRES_DB=starlight
VALKEY_PASSWORD=replace-with-url-safe-secret

# Bearer token of the classification service; also used by server (ML_API_TOKEN)
# and hindsight (embeddings + reranker API key) — must be identical everywhere.
CLASSIFICATION_API_TOKEN=replace-me
# Hindsight tenant API key; must match HINDSIGHT_API_KEY in apps/starlight/.env.
HINDSIGHT_API_KEY=replace-me
# Shared recall-query cap injected into both Hindsight and the bot.
HINDSIGHT_RECALL_MAX_QUERY_TOKENS=800
# LLM key for hindsight and the starlight bot (OpenRouter).
OPENROUTER_API_KEY=replace-me

# Optional: overrides the internal http://classification:8000 base URL that
# hindsight uses for embeddings and reranking; only needed for a remote service.
CLASSIFICATION_URL=
