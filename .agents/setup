#!/usr/bin/env bash
set -euo pipefail

SECONDS=0
TIMEFORMAT='Elapsed: %3R seconds'

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

export PATH="$HOME/.bun/bin:$PATH"

echo "Installing Bun 1.4.2"
if [[ "$(bun --version 2>/dev/null || true)" != "1.4.2" ]]; then
  time curl -fsSL --connect-timeout 10 --max-time 60 https://bun.sh/install | bash -s -- bun-v1.4.2
fi
if ! grep -Fqx "# Starlight Bun" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# Starlight Bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
EOF
fi

echo "Installing JavaScript dependencies"
time bun install --frozen-lockfile

echo "Generating the Prisma client"
time bun run db:generate

echo "Ensuring lint swap space"
# oxlint's JS-plugin arena reserves a ~4 GiB virtual memory region per
# worker; the Linux overcommit heuristic denies that when RAM + swap is below
# 4 GiB, crashing lint with an allocator panic. Ensure our swapfile is active
# so RAM + swap covers the reservation. The guard runs through sudo because
# swapon lives in /sbin, off the default orb PATH; checking for /swapfile
# itself (not just any swap) keeps re-runs idempotent — fallocate fails with
# "Text file busy" on live swap, so an already-active file must skip creation.
if ! sudo swapon --show=NAME --noheadings 2>/dev/null | grep -Fxq /swapfile; then
  if [[ ! -f /swapfile ]]; then
    time sudo fallocate -l 4G /swapfile
    sudo chmod 600 /swapfile
    time sudo mkswap /swapfile
  fi
  time sudo swapon /swapfile
fi

echo "Installing classification dependencies"
missing_packages=()
for package in libatomic1 libgomp1 libnuma1; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fq "install ok installed"; then
    missing_packages+=("$package")
  fi
done
if (( ${#missing_packages[@]} > 0 )); then
  time sudo apt-get update
  time sudo apt-get install -y --no-install-recommends "${missing_packages[@]}"
fi
time uv sync --project classification --frozen

echo "Orb setup complete in ${SECONDS}s"
