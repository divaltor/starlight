# @BotFather
BOT_TOKEN=

NODE_ENV=development

# Main database
DATABASE_URL=

# BullMQ (Redis-compatible; Valkey is used in Docker Compose)
REDIS_URL=redis://valkey:6379

# To encrypt cookies in storage
COOKIE_ENCRYPTION_KEY=
COOKIE_ENCRYPTION_SALT=

# To store images from scrapper process
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# To build link for accessing images on webpage
BASE_CDN_URL=
BASE_FRONTEND_URL=
DEFAULT_MEDIA_PATH='media/'

# Classification service
ML_BASE_URL=
ML_API_TOKEN=

ENABLE_CLASSIFICATION=true
ENABLE_EMBEDDINGS=true

# List of Telegram IDs which would have full control of bot in any chat (like creators or supervisors)
SUPERVISOR_IDS=

# List of group/supergroup chat IDs where the bot can handle /v-like group events
WHITELIST_CHAT_IDS=
