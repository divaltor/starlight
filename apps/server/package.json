    "@grammyjs/parse-mode": "2.3.0",
    "@grammyjs/runner": "2.0.3",
    "@grammyjs/types": "5.0.0",
    "@napi-rs/canvas": "1.0.8",
    "@roziscoding/grammy-autoquote": "2.0.9",
    "@starlight/api": "workspace:*",
    "@starlight/crypto": "workspace:*",
    "@starlight/utils": "workspace:*",
    "@t3-oss/env-core": "0.13.11",
    "@the-convocation/twitter-scraper": "0.22.3",
    "bullmq": "6.3.3",
    "date-fns": "4.4.0",
    "effect": "4.0.0-rc.112",
    "grammy": "catalog:",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "sharp": "0.35.4",
    "takumi-js": "2.13.3",
    "tmp": "0.2.7",
    "tough-cookie": "6.0.2",
    "user-agents": "2.1.169",
    "youtube-dl-exec": "3.1.13",
