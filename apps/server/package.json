{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun run -b tsdown",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "test": "bun test",
