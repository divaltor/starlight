# @BotFather token for the separate Starlight bot
STARLIGHT_BOT_TOKEN=

NODE_ENV=development
APP_NAME=Starlight
LOG_LEVEL=debug

# Shared database and BullMQ
DATABASE_URL=
REDIS_URL=redis://valkey:6379

# Required by shared configuration; Starlight does not read these values
COOKIE_ENCRYPTION_KEY=
COOKIE_ENCRYPTION_SALT=

# Shared attachment storage
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BASE_CDN_URL=

# AI chat replies
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
EXA_API_KEY=
EXA_API_BASE_URL=https://api.exa.ai
IGNORE_USER_CHANCE=0.75

# Langfuse observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Comma-separated group/supergroup IDs where this bot can reply
WHITELIST_CHAT_IDS=
BOT_ALIASES=starlight,звездочка,старка,стар
