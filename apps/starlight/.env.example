STARLIGHT_BOT_TOKEN=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starlight
REDIS_URL=redis://localhost:6379
CONVERSATION_BATCH_QUIET_MS=1000
CONVERSATION_BATCH_MAX_WAIT_MS=3000
RANDOM_RESPONSE_CHANCE=0.01
HINDSIGHT_BASE_URL=http://hindsight:8888
HINDSIGHT_API_KEY=
# Standalone bot runs use this file; Compose injects the shared value from the root .env.
HINDSIGHT_RECALL_MAX_QUERY_TOKENS=800
CONTEXT_COMPACTION_TRIGGER_TOKENS=28000
CONTEXT_RETAINED_TOKEN_TARGET=8000

AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

OPENROUTER_API_KEY=
TOPIC_METADATA_MODEL=openai/gpt-6-luna
STARLIGHT_MODEL=google/gemini-3-flash-preview
EXA_MCP_URL=https://mcp.exa.ai/mcp
EXA_API_KEY=

LOG_LEVEL=debug

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Axiom OTLP endpoint; the bot sends traces and logs straight there.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=Bearer <AXIOM_API_TOKEN>
OTEL_EXPORTER_OTLP_HEADERS=

# Attached to traces and logs as X-Axiom-Dataset. The Axiom plan allows three
# datasets, so logs share the existing `starlight` one.
AXIOM_TRACES_DATASET=starlight-traces
AXIOM_LOGS_DATASET=starlight
